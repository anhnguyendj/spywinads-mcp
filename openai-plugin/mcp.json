{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "spywinads": {
      "type": "streamable-http",
      "url": "https://spywinads.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": ["ads:read", "product:export"]
          }
        }
      }
    }
  }
}
